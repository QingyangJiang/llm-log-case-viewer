APP_PORT=8080
POSTGRES_DB=case_lens
POSTGRES_USER=case_lens
POSTGRES_PASSWORD=change-this-database-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
ADMIN_DISPLAY_NAME=管理员
SECURE_COOKIES=false
SESSION_HOURS=24
MAX_UPLOAD_MB=2048
# 私有 R2：四项都填；默认存储桶无需设置 JURISDICTION。不要添加 NEXT_PUBLIC_ 前缀。
# CODEX_SPRITE_R2_ACCOUNT_ID=你的32位Cloudflare账号ID
# CODEX_SPRITE_R2_BUCKET=case-lens-pets
# CODEX_SPRITE_R2_ACCESS_KEY_ID=你的R2访问密钥ID
# CODEX_SPRITE_R2_SECRET_ACCESS_KEY=你的R2秘密访问密钥
# 欧盟、美国或 FedRAMP 辖区存储桶可设为 eu、us 或 fedramp：
# CODEX_SPRITE_R2_JURISDICTION=eu
# 可选：仅图片使用的 HTTPS 入口，如 https://pets.example.com/codex-pets
# CODEX_SPRITE_PUBLIC_URL_PREFIX=https://pets.example.com/codex-pets
PIP_INDEX_URL=https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
